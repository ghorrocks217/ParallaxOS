     1                                  [org 0x7c00]
     2                                  [bits 16]
     3                                  
     4                                  start:
     5 00000000 31C0                        xor ax, ax
     6 00000002 8ED8                        mov ds, ax
     7 00000004 8EC0                        mov es, ax
     8 00000006 8ED0                        mov ss, ax
     9 00000008 BC007C                      mov sp, 0x7c00          ; stack grows down from just below the bootloader
    10 0000000B 8816[4300]                  mov [boot_drive], dl    ; BIOS puts the boot drive number in DL
    11                                  
    12 0000000F BE[4400]                    mov si, msg_loading
    13 00000012 E82200                      call print
    14                                  
    15 00000015 B402                        mov ah, 0x02            ; BIOS read sectors
    16 00000017 B004                        mov al, 4               ; how many sectors to read
    17 00000019 B500                        mov ch, 0               ; cylinder 0
    18 0000001B B102                        mov cl, 2               ; start at sector 2 (sector 1 is this bootloader)
    19 0000001D B600                        mov dh, 0               ; head 0
    20 0000001F 8A16[4300]                  mov dl, [boot_drive]
    21 00000023 BB007E                      mov bx, 0x7e00          ; load to ES:BX = 0x0000:0x7E00
    22 00000026 CD13                        int 0x13
    23 00000028 7205                        jc disk_error
    24                                  
    25 0000002A EA007E0000                  jmp 0x0000:0x7e00       ; jump to stage 2
    26                                  
    27                                  disk_error:
    28 0000002F BE[5700]                    mov si, msg_err
    29 00000032 E80200                      call print
    30 00000035 EBFE                        jmp $
    31                                  
    32                                  print:
    33 00000037 AC                          lodsb
    34 00000038 08C0                        or al, al
    35 0000003A 7406                        jz .done
    36 0000003C B40E                        mov ah, 0x0e
    37 0000003E CD10                        int 0x10
    38 00000040 EBF5                        jmp print
    39                                  .done:
    40 00000042 C3                          ret
    41                                  
    42 00000043 00                      boot_drive  db 0
    43 00000044 4C6F6164696E672073-     msg_loading db "Loading stage 2...", 0
    43 0000004D 7461676520322E2E2E-
    43 00000056 00                 
    44 00000057 4469736B2072656164-     msg_err     db "Disk read error!", 0
    44 00000060 206572726F722100   
    45                                  
