     1                                  [org 0x7c00]
     2                                  [bits 16]
     3                                  
     4                                  start:
     5 00000000 31C0                        xor ax, ax
     6 00000002 8ED8                        mov ds, ax
     7 00000004 8EC0                        mov es, ax
     8 00000006 8ED0                        mov ss, ax
     9 00000008 BC007C                      mov sp, 0x7c00          ; stack grows down from just below the bootloader
    10 0000000B 8816[4700]                  mov [boot_drive], dl    ; BIOS puts the boot drive number in DL
    11                                  
    12 0000000F BE[4800]                    mov si, msg_loading
    13 00000012 E82600                      call print
    14                                  
    15 00000015 B402                        mov ah, 0x02            ; BIOS read sectors
    16 00000017 B004                        mov al, 4               ; 4 sectors = 2048 bytes (stage 2)
    17 00000019 B500                        mov ch, 0               ; cylinder 0
    18 0000001B B102                        mov cl, 2               ; start at sector 2 (sector 1 is this bootloader)
    19 0000001D B600                        mov dh, 0               ; head 0
    20 0000001F 8A16[4700]                  mov dl, [boot_drive]
    21 00000023 BB007E                      mov bx, 0x7e00          ; load to 0x0000:0x7E00
    22 00000026 CD13                        int 0x13
    23 00000028 7209                        jc disk_error
    24                                  
    25 0000002A 8A16[4700]                  mov dl, [boot_drive]    ; pass the boot drive to stage 2
    26 0000002E EA007E0000                  jmp 0x0000:0x7e00
    27                                  
    28                                  disk_error:
    29 00000033 BE[5B00]                    mov si, msg_err
    30 00000036 E80200                      call print
    31 00000039 EBFE                        jmp $
    32                                  
    33                                  print:
    34 0000003B AC                          lodsb
    35 0000003C 08C0                        or al, al
    36 0000003E 7406                        jz .done
    37 00000040 B40E                        mov ah, 0x0e
    38 00000042 CD10                        int 0x10
    39 00000044 EBF5                        jmp print
    40                                  .done:
    41 00000046 C3                          ret
    42                                  
    43 00000047 00                      boot_drive  db 0
    44 00000048 4C6F6164696E672073-     msg_loading db "Loading stage 2...", 0
    44 00000051 7461676520322E2E2E-
    44 0000005A 00                 
    45 0000005B 4469736B2072656164-     msg_err     db "Disk read error!", 0
    45 00000064 206572726F722100   
    46                                  
    47 0000006C 00<rep 192h>            times 510-($-$$) db 0
    48 000001FE 55AA                    dw 0xAA55
